{
  "cpu": {
    "tooltip": false,
    "interval": 10,
    "format": "󰻠",
    "format-alt": "󰻠 <span size='11pt'>{usage}%</span>",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "temperature": {
    "tooltip": false,
    "interval": 10,
    "thermal-zone": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format": "{icon}",
    "format-alt": "{icon} <span size='11pt'>{temperatureC}°C</span>",
    "format-critical": "<span size='12pt'>󱗗 </span><span size='11pt'>{temperatureC}°C</span>",
    "format-icons": ["", "", ""]
  },
  "disk": {
    "tooltip": false,
    "interval": 3600,
    "path": "/",
    "format": "󱙋",
    "format-alt": "󱙋 <span size='11pt'>{used}</span>",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "memory": {
    "tooltip": false,
    "interval": 15,
    "format": "󰍛",
    "format-alt": "󰍛 <span size='11pt'>{used}</span>",
    "states": {
      "warning": 75,
      "critical": 85
    }
  },
  "custom/uptime": {
    "tooltip": false,
    "interval": 60,
    "format": "󰅐",
    "format-alt": "󰅐 <span size='11pt'>{}</span>",
    "exec": "uptime -p | sed -e 's/up //g'"
  }
}
