(defpoll datetime :interval "1s" "date +'%H:%M | %a |   %d %m %y'")



(defvar old_time 0)
(defvar new_time 0)
(defvar timer false)
(defvar timer_min 25)
(defvar timer_state "")
(defvar paused_elapsed 0)
(defvar timer_progress 0)
(defvar notif_state "{\"class\": \"dnd-off\"}")

(defpoll timer_str :interval '1s' :run-while timer 'scripts/timer update_timer')
