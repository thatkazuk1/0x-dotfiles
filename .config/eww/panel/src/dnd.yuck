(defwidget widget_dnd []
  (eventbox :cursor "pointer"
    (button :class "dnd-btn ${notif_state.class == 'dnd' ? 'dnd-on' : 'dnd-off'}"
      :onclick "bash ~/.config/eww/panel/scripts/dnd.sh toggle && eww update notif_state='$(bash ~/.config/eww/panel/scripts/dnd.sh state)' &"

      (box :orientation "vertical"
        :space-evenly false
        :spacing 8
        :valign "center"
        :halign "center"
        :hexpand true

        (box :class "dnd-box"
          :valign "center"
          :halign "center"
          (label :class "dnd-icon"
            :valign "center"
            :halign "center"
          :text {notif_state.class == 'dnd' ? "󰂛" : "󰂟"}))

        (box :orientation "vertical"
          :space-evenly false
          :spacing 0
          :valign "center"
          :halign "center"
          (label :class "label"
            :text "Do Not"
          :halign "center")
          (label :class "label"
            :text "Disturb"
          :halign "center")))
    )
  )
)
