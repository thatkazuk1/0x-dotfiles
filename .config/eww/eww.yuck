(defvar open_dashboard false)

;; --- ROOT ---
(include "./var.yuck")
(include "./panel/panel.yuck")
(include "./panel/src/wifi-menu.yuck")

;; --- PANEL ---
(defwindow window_panel
  :monitor 0
  :geometry (geometry :x "20px"
    :y "20px"
    :width "420px"
    :height "620px"
  :anchor "top right")
  :stacking "overlay"
  :namespace "eww-panel"
  :focusable false
  (widget_panel))

;; --- CLOSER ---
(defwindow window_closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :namespace "eww-closer"
  :focusable false
  (closer))

(defwidget closer []
  (eventbox
    :onclick "~/.config/waybar/scripts/eww/eww-toggle-panel.sh close &"
    (box :class "closer-surface")))
